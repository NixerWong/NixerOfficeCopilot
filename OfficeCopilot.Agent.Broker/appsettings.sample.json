{
  // Phase 1.3c: copy this file to either
  //   - the broker exe directory (OfficeCopilot.Agent.Broker\bin\Debug\net8.0\appsettings.json), or
  //   - %APPDATA%/NixerOfficeCopilot/appsettings.json (user-level override),
  // and rename to `appsettings.json`. Comments + trailing commas are tolerated.
  "storage": {
    // "InMemory" — process-local dictionary, lost on restart (legacy behavior).
    // "Jsonl"    — one JSONL file per conversation; default.
    "mode": "Jsonl",

    // Optional absolute path override for the JSONL root. Leave blank to use
    // %APPDATA%/NixerOfficeCopilot (resolved by JsonlPaths.DefaultRootDirectory).
    "jsonlRootDirectory": ""
  }
}
